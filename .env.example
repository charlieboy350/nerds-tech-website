# ------------------------------------------------------------------
# Contact form mailer (/api/contact)
# Copy this file to .env.local for local dev. On Vercel, add the same
# variables under Project Settings → Environment Variables.
# ------------------------------------------------------------------

# SMTP server that sends the mail (your mailbox provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to "true" only when using port 465, otherwise STARTTLS is used on 587
SMTP_SECURE=false

# The mailbox used to send (must be allowed to send via the SMTP server above)
SMTP_USER=support@nerdstech.co
SMTP_PASS=your-app-password-here

# Optional overrides (defaults shown)
# CONTACT_TO=support@nerdstech.co, info@nerdstech.co
# CONTACT_BCC=naeem.ur.rehman.co@gmail.com
